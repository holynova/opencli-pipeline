{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencli-pipeline",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "opencli-pipeline.xiaosang.cc",
      "custom_domain": true
    }
  ]
}
